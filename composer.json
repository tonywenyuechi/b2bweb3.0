{
    "name": "example/php-testing",
    "description": "PHP测试示例项目",
    "type": "project",
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "classmap": [
            "./"
        ]
    },
    "scripts": {
        "test": "php vendor/bin/phpunit CalculatorTest.php",
        "test-verbose": "php vendor/bin/phpunit -v CalculatorTest.php",
        "test-all": "php vendor/bin/phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
